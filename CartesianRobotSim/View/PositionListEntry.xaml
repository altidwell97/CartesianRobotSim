<UserControl x:Class="CartesianRobotSim.View.PositionListEntry"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:local="clr-namespace:CartesianRobotSim.View"
             DataContext="{DynamicResource PositionListEntryViewModel}"
             mc:Ignorable="d"
             d:DesignHeight="594"
             d:DesignWidth="528">
    <Grid Background="Transparent">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="*" />
            <RowDefinition Height="*" />
            <RowDefinition Height="50" />
            <RowDefinition Height="200" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!--X-Point-->
        <TextBlock Grid.Row="0"
                   Grid.Column="0"
                   Text="X"
                   HorizontalAlignment="Right" />
        <TextBox Grid.Row="0"
                 Grid.Column="1"
                 Text="{Binding XValue, UpdateSourceTrigger=PropertyChanged}" />

        <!--Y-Point-->
        <TextBlock Grid.Row="1"
                   Grid.Column="0"
                   Text="Y"
                   HorizontalAlignment="Right" />
        <TextBox Grid.Row="1"
                 Grid.Column="1"
                 Text="{Binding YValue, UpdateSourceTrigger=PropertyChanged}" />

        <!--Z-Point-->
        <TextBlock Grid.Row="2"
                   Grid.Column="0"
                   Text="Z"
                   HorizontalAlignment="Right" />
        <TextBox Grid.Row="2"
                 Grid.Column="1"
                 Text="{Binding ZValue, UpdateSourceTrigger=PropertyChanged}" />

        <!--AddButton-->
        <Button Grid.Row="3"
                Grid.Column="0"
                Content="Add"
                Style="{StaticResource Button}"
                Command="{Binding AddCommand}"
                ToolTip="{Binding AddDisabledMessage}"
                Margin="0,10,0,0"
                HorizontalAlignment="Center"
                VerticalAlignment="Bottom" />

        <!--RemoveButton-->
        <Button Grid.Row="3"
                Grid.Column="1"
                Content="Remove"
                Style="{StaticResource Button}"
                Command="{Binding RemoveCommand}"
                Margin="0,10,0,0"
                HorizontalAlignment="Center"
                VerticalAlignment="Bottom" />

        <!--SaveButton-->
        <Button Grid.Row="3"
                Grid.Column="2"
                Content="Save"
                Style="{StaticResource Button}"
                Command="{Binding SaveCommand}"
                Margin="0,10,0,0"
                HorizontalAlignment="Center"
                VerticalAlignment="Bottom" />

        <!-- Positions Added List -->
        <ListBox Grid.Row="4"
                 Grid.Column="0"
                 Grid.ColumnSpan="3"
                 ItemsSource="{Binding AddedPositions}"
                 SelectedItem="{Binding SelectedPoint, Mode=TwoWay}"
                 Height="180"
                 Width="500"
                 HorizontalAlignment="Center"
                 VerticalAlignment="Center"
                 ScrollViewer.CanContentScroll="True">
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <TextBlock Text="{Binding}" />
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>
        <!-- Save notification (shown briefly after successful save) -->
        <StackPanel Grid.Row="5"
                    Grid.Column="0"
                    Grid.ColumnSpan="3"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Margin="0,5,0,0">
            <TextBlock Text="{Binding SaveMessage}"
                       Foreground="Green"
                       HorizontalAlignment="Center" />
            <TextBlock Text="{Binding AddMessage}"
                       Foreground="DarkBlue"
                       HorizontalAlignment="Center" />
        </StackPanel>
    </Grid>
</UserControl>
