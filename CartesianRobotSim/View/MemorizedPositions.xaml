<UserControl x:Class="CartesianRobotSim.MVVM.View.MemorizedPositions"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:CartesianRobotSim.MVVM.View"
             mc:Ignorable="d" 
             d:DesignHeight="300" d:DesignWidth="1066">
    <Grid Background="White">
        <!-- Memorized Positions List -->
        <ListBox Grid.Row="4" Grid.Column="0" Grid.ColumnSpan="3"
                 ItemsSource="{Binding MemorizedPositions}" 
                 SelectedItem="{Binding SelectedPosition, Mode=TwoWay}"
                 DisplayMemberPath="Name"
                 Height="225" Width="1000"
                 HorizontalAlignment="Center" VerticalAlignment="Center"/>
                 <!--ScrollViewer.VerticalScrollBarVisibility="Auto"
                 ScrollViewer.HorizontalScrollBarVisibility="Auto"-->
        
        <!--Run Button-->
        <Button Content="Run" FontSize="16" 
                Click="Run_Click"
                Height="40" Width="100"
                Margin="0,10,0,0"
                HorizontalAlignment="Center" VerticalAlignment="Bottom"/>
        
    </Grid>
</UserControl>
