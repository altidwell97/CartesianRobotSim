<UserControl x:Class="CartesianRobotSim.View.MemorizedPositions"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:CartesianRobotSim.View"
             mc:Ignorable="d" 
             d:DesignHeight="297" d:DesignWidth="528">
    <Grid Background="White">
        <TextBlock Text="Memorized Positions" 
                   VerticalAlignment="Top"
                   HorizontalAlignment="Center"
                   Margin="0 0 0 10"/>
        <!-- Memorized Positions List -->
        <ListView ItemsSource="{Binding MemorizedPositions}"
                  SelectedItem="{Binding SelectedPosition, Mode=TwoWay}"
                  DisplayMemberPath="Name"
                  Height="225"
                  Width="500"
                  HorizontalAlignment="Center"
                  VerticalAlignment="Center"
                  Margin="0 0 0 10">
            <ListView.View>
                <GridView>
                    <GridViewColumn Header="Point 1"
                                    DisplayMemberBinding="{Binding Name}"
                                    Width="100" />
                    <GridViewColumn Header="Point 2"
                                    DisplayMemberBinding="{Binding X}"
                                    Width="100" />
                    <GridViewColumn Header="Point 3"
                                    DisplayMemberBinding="{Binding Y}"
                                    Width="100" />
                    <GridViewColumn Header="Point 4"
                                    DisplayMemberBinding="{Binding Z}"
                                    Width="100" />
                    <GridViewColumn Header="Point 5"
                                    DisplayMemberBinding="{Binding Z}"
                                    Width="100" />
                </GridView>
            </ListView.View>
        </ListView>

        <!--Run Button-->
        <Button Content="Run"
                Command="{Binding RunCommand}"
                Style="{StaticResource Button}"
                HorizontalAlignment="Center" VerticalAlignment="Bottom"
                Margin="0 0 0 5"/>
        
    </Grid>
</UserControl>
