<Window x:Class="CartesianRobotSim.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:CartesianRobotSim"
        xmlns:views="clr-namespace:CartesianRobotSim.View"
        mc:Ignorable="d"
        Title="Cartesian Robot Simulation" Height="891" Width="1584"
        ResizeMode="CanResizeWithGrip">

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition/>
            <ColumnDefinition/>
            <ColumnDefinition/>
        </Grid.ColumnDefinitions>

        <Grid.RowDefinitions>
            <RowDefinition/>
            <RowDefinition/>
            <RowDefinition/>
        </Grid.RowDefinitions>

        <!-- Robot Environment -->
        <DockPanel Grid.Row="0"
                   Grid.Column="0"
                   Grid.ColumnSpan="2"
                   Grid.RowSpan="2">
            <views:RobotEnvironment />
        </DockPanel>

        <!-- Position List Entry -->
        <DockPanel Grid.Row="0"
                   Grid.Column="2"
                   Grid.RowSpan="2">
            <views:PositionListEntry />
        </DockPanel>

        <!-- Manual Controls -->
        <DockPanel Grid.Row="2"
                   Grid.Column="0">
            <views:ManualControl />
        </DockPanel>

        <!-- Command Controls -->
        <DockPanel Grid.Row="2"
                   Grid.Column="1">
            <views:CommandControls />
        </DockPanel>

        <!-- Position List Entry -->
        <DockPanel Grid.Row="2"
                   Grid.Column="2">
            <views:MemorizedPositions />
        </DockPanel>


        <!--<StackPanel Orientation="Horizontal"
                    Grid.Row="0" Grid.Column="0" Grid.ColumnSpan="3">
        </StackPanel>-->
    </Grid>
</Window>
